<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Фоновое перекодирование: сервис держит уведомление с прогрессом. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- mediaProcessing — тип ровно под перекодирование (API 35+), без суточного
         лимита, в отличие от dataSync. На старых версиях тип из манифеста игнорируется. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- Без него уведомление сервиса на 13+ просто не показывается (работа не мешает). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Галерея роликов на вводе. На 13+ — granular-разрешение, ниже старое чтение. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Вывод по умолчанию — публичная Movies/eBrake. До 28 включительно туда
         пишется прямым File-путём, ему нужен WRITE. На 29+ пишем через
         MediaStore (свои файлы — без разрешений), поэтому maxSdkVersion. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ebrake">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Ebrake"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".transcode.TranscodeService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing" />
    </application>

</manifest>